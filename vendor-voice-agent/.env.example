# Anthropic (Claude) API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use for the agent's conversation and call summaries
CLAUDE_MODEL=claude-sonnet-5

# Your real phone number in E.164 format (e.g. +15551234567).
# Used when the agent escalates a call to you.
OWNER_PHONE_NUMBER=

# Twilio credentials — https://console.twilio.com/
# Used to validate that incoming webhook requests actually come from Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The public base URL this server is reachable at (no trailing slash).
# During local dev this is your ngrok URL, e.g. https://abcd1234.ngrok-free.app
# In production this is your real hosted domain.
PUBLIC_BASE_URL=

# Path to the local SQLite database file (created automatically)
DB_PATH=vendor_agent.db
